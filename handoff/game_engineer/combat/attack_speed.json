{
 "version": "as2",
 "replaces": "as1 (frames). Pure percent attack and cast speed, no frames. Backup of as1: attack_speed_as1.json",
 "player": {
  "baseAps": 1.89,
  "apsCap": 10.0,
  "apsFloor": 0.5,
  "classBaseAps": {
   "ironvow": 1.89,
   "longmark": 1.89,
   "cinderwake": 1.89,
   "gravewell": 1.89
  },
  "classNote": "No class differences: every class starts with a weaponSpeed 0 starter at exactly 1.89 APS; class identity comes from skills and gear.",
  "baseCastRate": 1.0,
  "castCap": 6.0,
  "castFloor": 0.25,
  "classBaseCast": {
   "ironvow": 1.0,
   "longmark": 1.0,
   "cinderwake": 1.0,
   "gravewell": 1.0
  },
  "weaponSkillMul": 1.15,
  "weaponSkillNote": "weapon skills (cleave, bladedance, execute, rupture, blindrush, javelin, aimed, smite) take swingSeconds*1.15 (replaces the old +2 frames on 13)"
 },
 "formula": {
  "aps": "clamp(baseAps * (1+weaponSpeed/100) * (1+ias/100) * (1+shrine/100) * (1+stride/100) * (1+boundIas/100) * (1-tradeoffIas/100) * tr(boundTradeoff()), apsFloor, apsCap). Every source is its own factor (fully multiplicative); ias = player.ias (gear + passives summed as today).",
  "swingSeconds": "1/aps",
  "hitSeconds": "swingSeconds * hitFrac (clip hitFrac = clips[clip].hitT/clips[clip].dur; bow uses sets.bow.hitFrac)",
  "cast": "castRate = clamp(baseCastRate * (1+fcr/100) * (1+knell/100) * (1+stride/100) * (1+weaponCastSpeed/100), castFloor, castCap); castSeconds = 1/castRate. fcr = round(gearFcr*100).",
  "weaponSpeed": "item.wspd if number, else bases[item.base].weaponSpeed, else 0. Items with no line roll [-10,-5,0,5,10] + tierBonus.",
  "tierBonusNoLine": {
   "normal": 0,
   "exceptional": 25,
   "elite": 50,
   "note": "only for items whose base has no entry in bases; line bases carry their own per-tier weaponSpeed"
  },
  "reqStat": "Cs(): reqBrawn when bases[base].reqStat==\"brawn\", else reqMark (same split as today wsm>=0)",
  "damage": "dmgHi = max(1, floor((6+rand*5) * rarity.m * (1+(ilvl-1)*0.13) * Zo[tier] * 100/(100+weaponSpeed) * (weight>=1.5 ? 1.12 : 1))); dmgLo = max(1, floor(dmgHi*(0.55+rand*0.12))). Replaces go(16,0,wsm)/16 in ws(). Zo = normal 1, exceptional 2.15, elite 3.8.",
  "dpsParity": "damage*APS is constant per tier and ilvl across all lines (floor rounding only); lines with weight>=1.5 (Timber Axe, Yew Longbow) keep the existing two-hand x1.12.",
  "animation": "two-segment timeScale: before clip.hitT ts = hitT/hitSeconds, after ts = (dur-hitT)/max(0.02, swingSeconds-hitSeconds). No timeScale clamp; at 10 APS ts reaches ~15-30, valid for AnimationMixer. __up masks while moving.",
  "elite": "elite tier only drops in Hell (ls(): elite -> exceptional when difficulty !== hell); an upgrade path (normal->exceptional->elite, same line) re-derives weaponSpeed and damage from this table."
 },
