{
 "version": "as1",
 "fps": 25,
 "source": "D2 AnimData A1/SC FramesPerDirection, StartingFrame, ActionFlagFrames (theamazonbasin.com Attack speed). src:d2 = real D2 value for the mapped class/wclass; src:adapted = mapped or derived.",
 "ias_stat": "ias",
 "fcr_stat": "gearFcr (x100)",
 "formula": {
  "EIAS": "min(75, floor(120*IAS/(120+IAS)) + skillIAS - WSM); IAS<0 is used linearly; floor -85",
  "IAS": "player.ias (affix stat `ias`, \"Increased Attack Speed\")",
  "skillIAS": "shrineIasT>0 ? 30 : 0, + longmark stride*(0.6+0.004*lv), + boundIasT>0 ? boundIas : 0, - Gn(boundTradeoff()).ias",
  "WSM": "item.wsm if number, else bases[item.base].wsm, else weaponTypeWsm[set]; cast uses WSM 0 and FCR in place of IAS",
  "rate": "floor(256*(100+EIAS)/100)",
  "frames": "max(minFrames(entry.min), ceil(256*base/rate) - 1)",
  "hitFrames": "min(frames-1, max(1, ceil(256*action/rate)))",
  "seconds": "frames/25 / er(boundTradeoff())  (atkPct multiplier); hitSeconds = hitFrames/25 / same",
  "timeScale": "average = clipDuration/(frames/25). Exact: two segments so the GLB contact lands on the action frame: before clip.hitT timeScale = clip.hitT/hitSeconds; after = (clip.dur-clip.hitT)/(seconds-hitSeconds)",
  "bow": "bow_draw (full clip) over hitSeconds, arrow looses at hitSeconds, bow_release over seconds-hitSeconds"
 },
