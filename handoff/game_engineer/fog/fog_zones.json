  "weatherMul": "1 + 1.5*clamp(game.fog,0,1)  (game.fog is the existing weather value; >0.16 = grim)",
  "max_alpha": 0.35,
  "applies_after": "existing scene distance fog (Fog 0x07080C 16-46) - unchanged",
  "transition_s": 2.5,
  "night_mul": 0.8,
  "note": "density is the max blend at the ground at full distance; values are deliberately tiny to keep the darkness"
