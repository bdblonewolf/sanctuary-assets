{
 "version": 1,
 "stage": "12B",
 "conventions": {
  "units": "1 unit = 1 m, glTF Y-up, origin = ring centre = map centre",
  "map_placement": "map tile (x,y) -> world (x - w/2, 0, y - h/2): tile x runs +X (east), tile y runs +Z (south); north = -Z",
  "yaw": "bearing = atan2(-z, x) in degrees (0 = east/+X, 90 = north/-Z, 180 = west/-X, 270 = south/+Z); all files are authored for rotationY = 0 and maps are axis-aligned, so rotationY is 0 for every map",
  "quadrants": "q = floor(((bearing + 45) mod 360) / 90): 0=E (315..45), 1=N (45..135), 2=W (135..225), 3=S (225..315); boundaries on the diagonals",
  "fog_rule": "use glb_v5_maps/fog_valley_banks_v5_quads.glb (nodes fog_E/N/W/S, same quadrant rule) instead of glb_v5 fog_valley_banks_v5.glb; hide the per-map hide_fog_nodes (sea quadrants, all four on islands maps) so no valley fog floats over open water",
  "node_names": "near file: near_land_{Q} (+ child trees_land_{Q}_n), near_sea_{Q} (+ trees_sea_{Q}_n), water_{Q}, apron_{Q}; mid/far quad files: mid_{Q}/far_{Q} (+ trees_mid_{Q})",
  "rule": "for each quadrant show near_land_Q + apron_Q (+ mid_Q, far_Q) if land; show near_sea_Q (+ hide mid_Q, far_Q, apron_Q) if sea; water_Q shown only on sea quadrants (land near rings contain gorges below sea level that would flood); hidden on land-only maps",
  "seams": "land/land and land/sea quadrants meet on the diagonals; sea quads keep full land height on the diagonals (headlands) and carry 4 m skirts on their radial edges, so any land/sea combination closes",
  "sea_y": -0.4,
  "apron_y": -0.1,
  "inner_edge": "lip at y=0 on radius = class (>= corner distance + ~6 m); near outer edge 288 m meets glb_v5 mid (inner ~280 m)",
  "tree_lod_bands_m": "near-file trees: LOD0 < class+59, LOD1 < class+129, LOD2 beyond; instance json trees_near_c{R}_{S}_instances.json lists them with set/quad so the engine can hide by quadrant",
  "fade": "COLOR_0.a = aerial-fade weight ss(60,2000,R) as glb_v5"
 },
