 "repo_note": "paths are repo-relative; load via uT(path,bust)",
 "v2_local_materials": {
  "note": "Martsirt v2: window glow cards (win_glow_* nodes) use LOCAL untextured materials, not library textures. emissiveFactor = #ffb060 (linear [1.0,0.434,0.117]), no KHR extensions; multiply by material extras.emissiveStrength at load (same convention as m_window_candlelit / m_peat_embers). Single-sided, dark base colour so the card reads as a dark pane when emissive is off.",
  "m_window_glow": {
   "emissiveStrength": 4.0,
   "use": "bright lit windows"
  },
  "m_window_glow_dim": {
   "emissiveStrength": 2.2,
   "use": "dim / back rooms / upper floors"
  },
  "m_window_glow_faint": {
   "emissiveStrength": 0.9,
   "use": "mill, stable - a single faint candle"
  },
  "m_window_glow_faint_glass": {
   "emissiveStrength": 0.9,
   "alphaMode": "BLEND",
   "alpha": 0.55,
   "use": "chapel chancel lancets"
  },
  "flicker": "node extras.flicker true on a win_glow_* card or fx_glow_window_* empty = runtime should modulate intensity (candle/hearth flicker)"
 }
}